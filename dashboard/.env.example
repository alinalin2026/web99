# Copy to .env.local and fill in. Never commit .env.local.

# --- database -------------------------------------------------------------
DATABASE_URL=postgres://user:pass@host/db

# --- where things live ----------------------------------------------------
APP_URL=https://dash.web99.ie
MARKETING_URL=https://web99.ie
PREVIEW_DOMAIN=web99.ie
PREVIEW_EXPIRY_DAYS=2
CRON_SECRET=

# --- dashboard access -----------------------------------------------------
ADMIN_PASSWORD=

# --- OpenAI: the single Web99 Agent --------------------------------------
OPENAI_API_KEY=

# Fast/cheap model: Sarah chat + structured extraction.
OPENAI_FAST_MODEL=gpt-5-mini

# Strong model: strategy, copy, workflow decisions and QA.
OPENAI_REASONING_MODEL=gpt-5.1
OPENAI_AGENT_MODEL=gpt-5.1
OPENAI_STUDIO_MODEL=gpt-5.1
OPENAI_QA_MODEL=gpt-5.1

# Final website coding/revision agent.
OPENAI_BUILD_MODEL=gpt-5.1

# Image generation.
OPENAI_IMAGE_MODEL=gpt-image-2

# Optional future browser/screenshot QA service. The dashboard already runs
# source-level OpenAI QA + an automatic repair pass without this.
VISUAL_QA_URL=
VISUAL_QA_TOKEN=

# --- the repo customer sites are pushed to -------------------------------
GITHUB_TOKEN=
SITES_REPO_OWNER=
SITES_REPO_NAME=
SITES_REPO_BRANCH=main

# --- stripe ---------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- telegram bot ---------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# --- email ----------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Web99 <hello@web99.ie>
EMAIL_REPLY_TO=hello@web99.ie

# --- automated lead followups --------------------------------------------
# Call GET /api/cron/followups with Authorization: Bearer $CRON_SECRET from
# any scheduler every 15-30 minutes if you want the 30m/24h/3d sequence.

# --- Meta Marketing API ---------------------------------------------------
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_GRAPH_VERSION=v24.0
META_ALLOW_LAUNCH=false
