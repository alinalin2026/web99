# Copy to .env.local and fill in. Never commit .env.local.

# --- database -------------------------------------------------------------
DATABASE_URL=postgres://user:pass@host/db

# --- where things live ----------------------------------------------------
APP_URL=https://dash.web99.ie
MARKETING_URL=https://web99.ie
PREVIEW_DOMAIN=web99.ie
PREVIEW_EXPIRY_DAYS=30

# --- dashboard access -----------------------------------------------------
# Long random string. Everyone who operates the dashboard shares it, so
# rotate it when somebody stops working on this.
OPERATOR_SECRET=

# --- models ---------------------------------------------------------------
OPENAI_API_KEY=
SARAH_MODEL=gpt-4o-mini
EXTRACT_MODEL=gpt-4o-mini
ANALYST_MODEL=gpt-4o
GENERATOR_MODEL=gpt-4o

# --- the repo customer sites are pushed to --------------------------------
# A fine-grained PAT with Contents: read+write on that repo only.
GITHUB_TOKEN=
SITES_REPO_OWNER=
SITES_REPO_NAME=
SITES_REPO_BRANCH=main

# --- stripe ---------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- email ----------------------------------------------------------------
# SPF, DKIM and DMARC must be set on the sending domain before this is used
# at any volume, or "your website is live" lands in spam.
RESEND_API_KEY=
EMAIL_FROM=Web99 <hello@web99.ie>
EMAIL_REPLY_TO=hello@web99.ie
