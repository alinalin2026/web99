# Copy to /srv/web99/config/dashboard.env on AWS and fill in.
# Never commit the real file.

# --- database -------------------------------------------------------------
DATABASE_URL=postgres://web99:CHANGE_ME@127.0.0.1:5432/web99

# --- canonical public URLs ------------------------------------------------
APP_URL=https://web99.ie
MARKETING_URL=https://web99.ie
PREVIEW_DOMAIN=web99.ie
PREVIEW_EXPIRY_DAYS=2
CRON_SECRET=

# --- dashboard access -----------------------------------------------------
ADMIN_PASSWORD=

# --- Sarah chat uploads (photos/documents, up to 100MB each) --------------
# Absolute path on disk, outside any git checkout so a redeploy never
# touches uploaded files. Must exist and be writable by the dashboard user.
UPLOAD_DIR=/srv/web99/uploads

# --- Anthropic (Claude): Sarah, previews, planning, copy, build, QA, Ops Agent
# Every model variable is optional and defaults to claude-sonnet-5. Move a role to a
# stronger model (e.g. claude-opus-5) by setting just that variable.
ANTHROPIC_API_KEY=
# ANTHROPIC_SARAH_MODEL=            # Sarah's chat replies
# ANTHROPIC_SARAH_EFFORT=low        # low | medium | high | xhigh | max
# ANTHROPIC_EXTRACT_MODEL=          # lead-brief extraction + "finished?" classifier
# ANTHROPIC_REASONING_MODEL=        # strategy plan; also the fallback for the next four
# ANTHROPIC_STUDIO_MODEL=
# ANTHROPIC_QA_MODEL=
# ANTHROPIC_BUILD_MODEL=            # writes the site's code
# ANTHROPIC_AGENT_MODEL=            # workflow controller
# ANTHROPIC_OPS_MODEL=              # Ops Agent (dashboard + standalone console)
# ANTHROPIC_INSTANT_SITE_MODEL=     # the free full-page preview on /start
# ANTHROPIC_INSTANT_SITE_EFFORT=low
# ANTHROPIC_DEFAULT_EFFORT=medium   # roles that don't set their own
# ANTHROPIC_FALLBACKS=off           # disable server-side refusal fallback (only applies to opus-5/fable-5, not the sonnet default)

# --- OpenAI: image generation ONLY (logos + photos; Anthropic has no image model)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# Optional future browser/screenshot QA service.
VISUAL_QA_URL=
VISUAL_QA_TOKEN=

# GitHub is NOT part of customer builds or preview publishing anymore.
# Keep these empty unless a future backup/mirroring feature explicitly uses them.
GITHUB_TOKEN=
SITES_REPO_OWNER=
SITES_REPO_NAME=
SITES_REPO_BRANCH=main

# --- stripe ---------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- telegram bot ---------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# --- email ----------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Web99 <hello@web99.ie>"
EMAIL_REPLY_TO=hello@web99.ie

# --- worker ---------------------------------------------------------------
WORKER_POLL_MS=1200

# --- Meta Marketing API ---------------------------------------------------
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_GRAPH_VERSION=v24.0
META_ALLOW_LAUNCH=false
