# Copy to .env.local and fill in. Never commit .env.local.

# --- database -------------------------------------------------------------
DATABASE_URL=postgres://user:pass@host/db

# --- where things live ----------------------------------------------------
APP_URL=https://dash.web99.ie
MARKETING_URL=https://web99.ie
PREVIEW_DOMAIN=web99.ie
PREVIEW_EXPIRY_DAYS=2
CRON_SECRET=

# --- dashboard access -----------------------------------------------------
ADMIN_PASSWORD=

# --- Claude: Sarah, planning, studio and QA -------------------------------
ANTHROPIC_API_KEY=
SARAH_MODEL=claude-haiku-4-5-20251001
EXTRACT_MODEL=claude-haiku-4-5-20251001
ANALYST_MODEL=claude-sonnet-4-6
STUDIO_MODEL=claude-sonnet-4-6
QA_MODEL=claude-sonnet-4-6

# --- OpenAI: image generation + temporary build fallback -----------------
OPENAI_API_KEY=
OPENAI_BUILD_MODEL=gpt-5.6
OPENAI_IMAGE_MODEL=gpt-image-2

# --- Claude Code runner ---------------------------------------------------
# Optional until you wire the worker. When absent, the dashboard uses the
# existing OpenAI builder as a fallback so the pipeline remains testable.
# Runner POST contract:
#   { action:'build'|'revise', orderId, project/currentFiles, callbackUrl, callbackToken }
# It may return { files:{...} } synchronously or { status:'queued', jobId:'...' }.
# Async runners POST progress/final files to /api/runner/callback with
# Authorization: Bearer $CLAUDE_CODE_CALLBACK_TOKEN.
CLAUDE_CODE_RUNNER_URL=
CLAUDE_CODE_RUNNER_TOKEN=
CLAUDE_CODE_CALLBACK_TOKEN=

# --- the repo customer sites are pushed to -------------------------------
GITHUB_TOKEN=
SITES_REPO_OWNER=
SITES_REPO_NAME=
SITES_REPO_BRANCH=main

# --- stripe ---------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- telegram bot ---------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# --- email ----------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Web99 <hello@web99.ie>
EMAIL_REPLY_TO=hello@web99.ie

# --- automated lead followups --------------------------------------------
# Call GET /api/cron/followups with Authorization: Bearer $CRON_SECRET from
# any scheduler every 15-30 minutes if you want the 30m/24h/3d sequence.

# --- Meta Marketing API ---------------------------------------------------
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_GRAPH_VERSION=v24.0
META_ALLOW_LAUNCH=false
