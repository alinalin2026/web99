# Copy to .env.local and fill in. Never commit .env.local.

# --- database -------------------------------------------------------------
DATABASE_URL=postgres://user:pass@host/db

# --- where things live ----------------------------------------------------
APP_URL=https://dash.web99.ie
MARKETING_URL=https://web99.ie
PREVIEW_DOMAIN=web99.ie
PREVIEW_EXPIRY_DAYS=2
CRON_SECRET=

# --- dashboard access -----------------------------------------------------
ADMIN_PASSWORD=

# --- Claude: chat, extraction, planning ----------------------------------
ANTHROPIC_API_KEY=
SARAH_MODEL=claude-haiku-4-5-20251001
EXTRACT_MODEL=claude-haiku-4-5-20251001
ANALYST_MODEL=claude-sonnet-4-6

# --- OpenAI: final website + visual assets -------------------------------
# Only used after an operator reviews Claude's plan and clicks Build + publish.
OPENAI_API_KEY=
OPENAI_BUILD_MODEL=gpt-5.6
OPENAI_IMAGE_MODEL=gpt-image-2

# --- the repo customer sites are pushed to -------------------------------
GITHUB_TOKEN=
SITES_REPO_OWNER=
SITES_REPO_NAME=
SITES_REPO_BRANCH=main

# --- stripe ---------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- telegram bot ---------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# --- email ----------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Web99 <hello@web99.ie>
EMAIL_REPLY_TO=hello@web99.ie

# --- Meta Marketing API ---------------------------------------------------
# Keep the access token server-side only. For Web99's own ad account, use a
# Meta Business system-user access token with ads_read + ads_management.
META_ACCESS_TOKEN=
# Digits only or act_123...; both forms are accepted.
META_AD_ACCOUNT_ID=
# Optional when the ad account exposes promote_pages; set explicitly if not.
META_PAGE_ID=
# Current version when this integration was added (August 2026).
META_GRAPH_VERSION=v24.0
# Safety latch. Keep false while creating/reviewing PAUSED campaigns.
# Set true only when the operator should be allowed to launch spend.
META_ALLOW_LAUNCH=false
