# Copy to .env.local and fill in. Never commit .env.local.

# --- database -------------------------------------------------------------
DATABASE_URL=postgres://user:pass@host/db

# --- where things live ----------------------------------------------------
APP_URL=https://dash.web99.ie
MARKETING_URL=https://web99.ie
PREVIEW_DOMAIN=web99.ie
# Must match the "48 hours" promised on the site and in the Terms of
# Service — 2 days. Enforced daily by the expire-previews cron below,
# not instantly, since Vercel's Hobby plan only runs crons once a day.
PREVIEW_EXPIRY_DAYS=2

# Shared secret Vercel's scheduler sends as "Authorization: Bearer <this>"
# when it calls /api/cron/expire-previews. Any long random string.
CRON_SECRET=

# --- dashboard access -----------------------------------------------------
# Long random string. Everyone who operates the dashboard shares it, so
# rotate it when somebody stops working on this.
ADMIN_PASSWORD=

# --- models ---------------------------------------------------------------
ANTHROPIC_API_KEY=
SARAH_MODEL=claude-haiku-4-5-20251001
EXTRACT_MODEL=claude-haiku-4-5-20251001
ANALYST_MODEL=claude-sonnet-4-6
GENERATOR_MODEL=claude-sonnet-4-6

# --- the repo customer sites are pushed to --------------------------------
# A fine-grained PAT with Contents: read+write on that repo only.
GITHUB_TOKEN=
SITES_REPO_OWNER=
SITES_REPO_NAME=
SITES_REPO_BRANCH=main

# --- stripe -----------------------------------------------------------------
# Webhook endpoint to register in the Stripe Dashboard (Developers > Webhooks
# > Add endpoint), event: checkout.session.completed. Must be APP_URL + this
# exact path:
#   https://dash.web99.ie/api/stripe
# Stripe gives you STRIPE_WEBHOOK_SECRET (starts "whsec_") when you create it.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- telegram bot -----------------------------------------------------------
# The channel customers use to update their site and buy add-ons after they've
# stayed with us. Not built yet — see dashboard/README.md.
# Create with @BotFather, then set the webhook to APP_URL + /api/telegram.
TELEGRAM_BOT_TOKEN=

# --- email ----------------------------------------------------------------
# SPF, DKIM and DMARC must be set on the sending domain before this is used
# at any volume, or "your website is live" lands in spam.
RESEND_API_KEY=
EMAIL_FROM=Web99 <hello@web99.ie>
EMAIL_REPLY_TO=hello@web99.ie>
