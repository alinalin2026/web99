[Unit]
Description=Web99 dashboard and API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/web99/app/dashboard
Environment=NODE_ENV=production
EnvironmentFile=/srv/web99/config/dashboard.env
ExecStart=/usr/bin/env npm start
Restart=always
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
