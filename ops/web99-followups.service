[Unit]
Description=Send due Web99 follow-up emails
After=web99-dashboard.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
EnvironmentFile=/srv/web99/config/dashboard.env
# Bearer token goes in via stdin so it never appears in the process list. $$ keeps systemd from expanding it.
ExecStart=/bin/bash -c 'echo "Authorization: Bearer $$CRON_SECRET" | curl -fsS --max-time 55 -H @- http://127.0.0.1:3000/control/api/cron/followups'
Nice=10
