{
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/westprint3d", "destination": "/assets/westprint3d/index.html" },
    { "source": "/westprint3d/", "destination": "/assets/westprint3d/index.html" },
    { "source": "/westprint3d/:path*", "destination": "/assets/westprint3d/:path*" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
