{
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/westprint3d", "destination": "/assets/westprint3d/index" },
    { "source": "/westprint3d/", "destination": "/assets/westprint3d/index" },
    { "source": "/westprint3d/:path*", "destination": "/assets/westprint3d/:path*" },
    { "source": "/inspire-goalkeeping/coaching", "destination": "/inspire-goalkeeping/index.html" },
    { "source": "/inspire-goalkeeping/about", "destination": "/inspire-goalkeeping/index.html" },
    { "source": "/inspire-goalkeeping/contact", "destination": "/inspire-goalkeeping/index.html" },
    { "source": "/inspire-goalkeeping/terms", "destination": "/inspire-goalkeeping/index.html" },
    { "source": "/inspire-goalkeeping/privacy", "destination": "/inspire-goalkeeping/index.html" },
    { "source": "/inspire-goalkeeping-v2/coaching", "destination": "/inspire-goalkeeping-v2/index.html" },
    { "source": "/inspire-goalkeeping-v2/about", "destination": "/inspire-goalkeeping-v2/index.html" },
    { "source": "/inspire-goalkeeping-v2/contact", "destination": "/inspire-goalkeeping-v2/index.html" },
    { "source": "/inspire-goalkeeping-v2/terms", "destination": "/inspire-goalkeeping-v2/index.html" },
    { "source": "/inspire-goalkeeping-v2/privacy", "destination": "/inspire-goalkeeping-v2/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
